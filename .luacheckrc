std = "lua51"
max_line_length = 120

-- Generated by `make import`, one entry per line by design.
exclude_files = { "data/" }

-- Globals the addon writes: saved variables and slash command registration.
globals = {
    "SLASH_TANDEM1",
    "SlashCmdList",
    "TandemDB",
}

-- WoW API used by the addon; add new ones here as the addon grows.
read_globals = {
    "C_Item",
    "C_Map",
    "C_Timer",
    "CreateFrame",
    "GetLocale",
    "GetLootSlotLink",
    "GetLootSourceInfo",
    "GetNumLootItems",
    "GetTime",
    "InCombatLockdown",
    "issecretvalue",
    "time",
    "UnitGUID",
    "UnitName",
}
