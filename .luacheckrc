std = "lua51"
max_line_length = 120

-- Generated by `make import`, one entry per line by design.
exclude_files = { "data/", "Tandem/Data/" }

-- Globals the addon writes: saved variables and slash command registration.
globals = {
    "SLASH_TANDEM1",
    "SlashCmdList",
    "TandemDB",
}

-- WoW API used by the addon; add new ones here as the addon grows.
read_globals = {
    "ButtonFrameTemplate_HideButtonBar",
    "ButtonFrameTemplate_HidePortrait",
    "C_Item",
    "C_Map",
    "C_Timer",
    "CombatLogGetCurrentEventInfo",
    "CreateDataProvider",
    "CreateFrame",
    "CreateScrollBoxListLinearView",
    "GameTooltip",
    "GetInventoryItemLink",
    "GetLocale",
    "GetLootSlotLink",
    "GetLootSourceInfo",
    "GetNumLootItems",
    "GetTime",
    "InCombatLockdown",
    "issecretvalue",
    "ScrollUtil",
    "time",
    "UIParent",
    "UISpecialFrames",
    "UnitClass",
    "UnitGUID",
    "UnitLevel",
    "UnitName",
}
